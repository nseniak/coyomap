 "glossary": [
  {
   "term": "Tenant",
   "meaning": "the customer account a ticket belongs to; every read and write is scoped to one",
   "source": "src/auth/gate.py:32"
  },
  {
   "term": "Lifecycle",
   "meaning": "the five declared ticket states and the transitions between them",
   "source": "src/lifecycle/states.py:14"
  },
  {
   "term": "Channel",
   "meaning": "a named pub/sub topic the publisher writes and (sometimes) a consumer drains",
   "source": "src/messaging/publisher.py:29"
  },
  {
   "term": "Trap",
   "meaning": "a defect deliberately planted in this tree, declared in traps.yaml, asserted by one regression layer",
   "source": "traps.yaml:1"
  }
 ],
 "use_cases": [
  {
   "id": "UC1",
   "name": "Browse a tenant's tickets",
   "actors": [
    "R2"
   ],
   "trigger": "An agent asks for a tenant's queue, optionally filtered by state",
   "outcome": "they get the list of tickets they are allowed to see, each with its state and comment count.",
   "capability": null,
   "entry_points": []
  },
  {
   "id": "UC2",
   "name": "Read one ticket",
   "actors": [
    "R2"
   ],
   "trigger": "Someone opens a ticket by id",
   "outcome": "they see its title, state, assignee and its comment thread, or a 404 when the ticket belongs to another tenant.",
   "capability": null,
   "entry_points": []
  },
  {
   "id": "UC3",
   "name": "Move a ticket along its lifecycle",
   "actors": [
    "R2"
   ],
   "trigger": "An agent posts a target state",
   "outcome": "the transition is checked against the declared table, the ticket is stored in its new state, re-indexed, and a state-change event is published.",
   "capability": null,
   "entry_points": []
  },
  {
   "id": "UC4",
   "name": "Comment on a ticket",
   "actors": [
    "R1"
   ],
   "trigger": "A reporter posts text on a ticket they may write",
   "outcome": "the comment is appended to the ticket document and the thread comes back one longer.",
   "capability": null,
   "entry_points": []
  },
  {
   "id": "UC5",
   "name": "Take an advisory lock",
   "actors": [
    "R2"
   ],
   "trigger": "An operator claims a named lock before a bulk job",
   "outcome": "the lock row records the holder, so a second claim can see who holds it.",
   "capability": null,
   "entry_points": []
  }
 ],
